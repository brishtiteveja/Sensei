# Sensei runtime config. Copy to .env and fill SENSEI_API_KEY.
#
#   cp .env.example .env      # then edit SENSEI_API_KEY
#   set -a; source .env; set +a   # export into shell, then run the app
#
# The app reads os.environ directly (no dotenv), so vars must be EXPORTED.
# Lines use `export` so `source .env` alone is enough and child procs (uv run) inherit.

# --- Router: OpenAI-compatible vllm endpoint on the DGX Spark (GB10) ---
# Pick ONE base URL.

# On the box itself (real deployment): loopback, no token needed.
# export SENSEI_BASE_URL=http://localhost:8010/v1

# Remote dev over the tailnet: faster (no funnel hop), needs Tailscale on this client.
# export SENSEI_BASE_URL=http://spark-e257.tail803c7f.ts.net:8010/v1

# Remote dev over the public Tailscale Funnel: works anywhere, real TLS.
export SENSEI_BASE_URL=https://spark-e257.tail803c7f.ts.net:8443/v1

# Bearer token. Source: models/router-api-key.txt ON THE BOX. Never commit the real one.
export SENSEI_API_KEY=

# Model pin. One model is resident at a time; a different id triggers a 1-5 min cold swap.
export SENSEI_MODEL=qwen3-vl-30b-a3b-gguf

# Client timeout (s). Must exceed a cold swap, else a slow-but-fine request looks like a hang.
export SENSEI_TIMEOUT=900

# Offline guard. Default 1 (on). It already allows *.ts.net hosts, so the funnel/tailnet
# URLs above pass with it on. Set 0 only to point at a non-tailnet, non-local host.
# export SENSEI_OFFLINE=1

# --- Payments (sensei/payments.py): bKash and Nagad ---
# Unset credentials leave that gateway listed but disabled in the app. These are
# the only calls meant to leave the box; SENSEI_OFFLINE does not govern them, and
# payments simply do not work without a network.

# bKash tokenized checkout. BKASH_BASE_URL defaults to the sandbox; set it to the
# live URL bKash issues with the merchant account.
# export BKASH_BASE_URL=
# export BKASH_APP_KEY=
# export BKASH_APP_SECRET=
# export BKASH_USERNAME=
# export BKASH_PASSWORD=

# Nagad. Keys as PEM (\n escapes fine) or bare base64 from the merchant panel.
# NAGAD_BASE_URL defaults to the sandbox; set it to the live URL Nagad issues.
# export NAGAD_BASE_URL=
# export NAGAD_MERCHANT_ID=
# export NAGAD_MERCHANT_PRIVATE_KEY=
# export NAGAD_PG_PUBLIC_KEY=

# Where the gateway sends the student's browser after checkout. Must be THIS
# server, reachable from the phone (so not localhost on a device), and HTTPS in
# production. Either one base URL, or a full URL per gateway.
# export PAYMENT_CALLBACK_BASE_URL=https://api.example.com
# export BKASH_CALLBACK_URL=https://api.example.com/payments/bkash/callback
# export NAGAD_CALLBACK_URL=https://api.example.com/payments/nagad/callback

# Where the callback then sends the browser: the app. Defaults to sensei://
# export APP_DEEP_LINK_BASE=sensei://

# Hours a started payment stays open. Default 24.
# export SUBSCRIPTION_PAYMENT_EXPIRES_HOURS=24
