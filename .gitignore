# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
uv.lock

# Local learner data -- student records never belong in git
*.db
*.sqlite3

# Secrets. The router bearer token lives in the environment, never in the repo.
.env
.env.*
!.env.example

# Node / Expo
node_modules/
.expo/
dist/
*.log

# OS
.DS_Store

# Active course is runtime state, rebuilt by POST /curriculum/build.
# A known-good copy lives in backend/fixtures/ as demo insurance.
backend/graph.json

# Vision sweep intermediates: regenerable, and the fonts are copied system files.
docs/vision_samples/_fonts/
docs/vision_samples/_preproc/
docs/lang_samples/_fonts/

# Web build output
web/dist/
web/node_modules/

# Sample images are copied into web/public at build prep; source of truth is /samples
web/public/samples/

# NoTeS-Bank subset staged into web/public at build time; source is /datasets
web/public/notesbank/
web/public/slides/
