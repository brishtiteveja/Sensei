# SenseiClaw — tutor, curriculum, question bank.
#
# Must be HTTPS: iOS ATS and Android 9+ block cleartext in release builds, so a
# raw `http://<ip>:<port>` works in dev and fails on every real device.
#
# The proxy in front of it must also pass POST. As of Aug 2026 the production
# route (https://drishtikon.life/sensei/api) serves GET but answers 405 to every
# POST at the nginx layer, which breaks chat, coaching and recording while
# leaving curriculum browsing looking fine.
EXPO_PUBLIC_SENSEI_API_URL=https://dev.perspectivity.co/sensei/api

# NestJS — accounts, mocktests. Defaults to localhost:3000 in dev.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Sensei backend (backend/sensei) — community, saved mock-test attempts, payments
# and AI credits. Defaults to localhost:8000 in dev (10.0.2.2:8000 on the Android
# emulator). Same HTTPS and POST rules as above apply on a real device.
# EXPO_PUBLIC_BACKEND_URL=https://api.example.com
